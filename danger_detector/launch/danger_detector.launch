<launch>
  <node pkg="danger_detector" type="danger_detector_node.py" name="danger_detector" output="screen">
    <param name="rgb_topic" value="/real_sense/rgb/image_raw"/>
    <param name="depth_topic" value="/real_sense/depth/image_raw"/>
    <param name="camera_info_topic" value="/real_sense/rgb/camera_info"/>
    <param name="world_frame" value="world"/>
    <param name="cluster_radius_m" value="0.75"/>
    <param name="min_cluster_observations" value="2"/>
    <param name="process_every_n" value="1"/>
  </node>
</launch>
