Panels:
  - Class: rviz/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /FUEL Map1
        - /FUEL Planning1
        - /Dog State1
      Splitter Ratio: 0.5
    Tree Height: 70
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Nav Goal1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: depth_image
Preferences:
  PromptSaveOnExit: false
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.44999998807907104
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 160
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/Group
      Displays:
        - Alpha: 0.75
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 80; 80; 80
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Min Color: 0; 0; 0
          Name: occupied_local
          Position Transformer: ""
          Queue Size: 10
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.07999999821186066
          Style: Boxes
          Topic: /sdf_map/occupancy_local
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        - Alpha: 0.25
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 255; 80; 30
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Min Color: 0; 0; 0
          Name: occupied_inflate
          Position Transformer: ""
          Queue Size: 10
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.07999999821186066
          Style: Boxes
          Topic: /sdf_map/occupancy_local_inflate
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        - Alpha: 0.20000000298023224
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 100; 100; 255
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: false
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Min Color: 0; 0; 0
          Name: unknown
          Position Transformer: ""
          Queue Size: 10
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.009999999776482582
          Style: Points
          Topic: /sdf_map/unknown
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: false
        - Alpha: 0.8999999761581421
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 255; 255; 255
          Color Transformer: ZAxis
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Min Color: 0; 0; 0
          Name: depth_cloud
          Position Transformer: ""
          Queue Size: 10
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.009999999776482582
          Style: Points
          Topic: /sdf_map/depth_cloud
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /sdf_map/update_range
          Name: update_range
          Namespaces:
            {}
          Queue Size: 10
          Value: true
      Enabled: true
      Name: FUEL Map
    - Class: rviz/Group
      Displays:
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /planning_vis/frontier
          Name: frontier
          Namespaces:
            {}
          Queue Size: 10
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /planning_vis/viewpoints
          Name: viewpoints
          Namespaces:
            {}
          Queue Size: 10
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /planning_vis/trajectory
          Name: planned_bspline
          Namespaces:
            {}
          Queue Size: 10
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 80; 220; 255
          Enabled: true
          Head Diameter: 0.30000001192092896
          Head Length: 0.20000000298023224
          Length: 0.30000001192092896
          Line Style: Lines
          Line Width: 0.07999999821186066
          Name: generated_path
          Offset:
            X: 0
            Y: 0
            Z: 0.029999999329447746
          Pose Color: 80; 220; 255
          Pose Style: None
          Queue Size: 10
          Radius: 0.029999999329447746
          Shaft Diameter: 0.10000000149011612
          Shaft Length: 0.10000000149011612
          Topic: /fuel_dog_adapter/generated_path
          Unreliable: false
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /planning_vis/topo_path
          Name: topo_path
          Namespaces:
            {}
          Queue Size: 10
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /planning_vis/yaw
          Name: yaw
          Namespaces:
            {}
          Queue Size: 10
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /planning/travel_traj
          Name: executed_traj
          Namespaces:
            {}
          Queue Size: 10
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 255; 190; 60
          Enabled: true
          Head Diameter: 0.30000001192092896
          Head Length: 0.20000000298023224
          Length: 0.30000001192092896
          Line Style: Lines
          Line Width: 0.07999999821186066
          Name: executed_path
          Offset:
            X: 0
            Y: 0
            Z: 0.05999999865889549
          Pose Color: 255; 190; 60
          Pose Style: None
          Queue Size: 10
          Radius: 0.029999999329447746
          Shaft Diameter: 0.10000000149011612
          Shaft Length: 0.10000000149011612
          Topic: /fuel_dog_adapter/executed_path
          Unreliable: false
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /planning/position_cmd_vis
          Name: position_cmd
          Namespaces:
            {}
          Queue Size: 10
          Value: true
      Enabled: true
      Name: FUEL Planning
    - Class: rviz/Group
      Displays:
        - Angle Tolerance: 0.05000000074505806
          Class: rviz/Odometry
          Covariance:
            Orientation:
              Alpha: 0.5
              Color: 255; 255; 127
              Color Style: Unique
              Frame: Local
              Offset: 1
              Scale: 1
              Value: true
            Position:
              Alpha: 0.30000001192092896
              Color: 204; 51; 204
              Scale: 1
              Value: true
            Value: true
          Enabled: true
          Keep: 100
          Name: odom
          Position Tolerance: 0.05000000074505806
          Queue Size: 10
          Shape:
            Alpha: 1
            Axes Length: 1
            Axes Radius: 0.10000000149011612
            Color: 255; 25; 0
            Head Length: 0.30000001192092896
            Head Radius: 0.10000000149011612
            Shaft Length: 1
            Shaft Radius: 0.05000000074505806
            Value: Arrow
          Topic: /Odometry_gazebo
          Unreliable: false
          Value: true
        - Alpha: 1
          Axes Length: 0.5
          Axes Radius: 0.029999999329447746
          Class: rviz/Pose
          Color: 255; 25; 0
          Enabled: true
          Head Length: 0.30000001192092896
          Head Radius: 0.10000000149011612
          Name: sensor_pose
          Queue Size: 10
          Shaft Length: 1
          Shaft Radius: 0.05000000074505806
          Shape: Axes
          Topic: /fuel_dog_adapter/sensor_pose
          Unreliable: false
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /fuel_dog_adapter/cmd_vel_marker
          Name: cmd_vel_arrow
          Namespaces:
            {}
          Queue Size: 10
          Value: true
        - Class: rviz/Image
          Enabled: false
          Image Topic: /real_sense/depth/image_raw
          Max Value: 5
          Median window: 5
          Min Value: 0
          Name: depth_image
          Normalize Range: true
          Queue Size: 2
          Transport Hint: raw
          Unreliable: false
          Value: false
      Enabled: true
      Name: Dog State
  Enabled: true
  Global Options:
    Background Color: 30; 30; 30
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Theta std deviation: 0.2617993950843811
      Topic: /initialpose
      X std deviation: 0.5
      Y std deviation: 0.5
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 18
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.7853981852531433
      Focal Point:
        X: 0
        Y: 0
        Z: 0.800000011920929
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.7450000047683716
      Target Frame: world
      Yaw: 0.7850000262260437
    Saved: ~
Window Geometry:
  Displays:
    collapsed: true
  Height: 900
  Hide Left Dock: true
  Hide Right Dock: false
  QMainWindow State: 
  Selection:
    collapsed: true
  Time:
    collapsed: true
  Tool Properties:
    collapsed: true
  Views:
    collapsed: true
  Width: 1400
  X: 80
  Y: 23
  depth_image:
    collapsed: true
